// ==================== WNDPROC ====================

LRESULT CALLBACK WndProc(HWND h, UINT m, WPARAM w, LPARAM l) {
    if (m == WM_KEYDOWN && w == VK_INSERT) { 
        g_ShowMenu = !g_ShowMenu; 
        return 0; 
    }
    
    // Block keyboard input during console command execution
    bool blockKeyboard = g_ConsoleBusy || 
                         (g_ConsoleBlockUntil != 0 && GetTickCount() < g_ConsoleBlockUntil);
    
    if (blockKeyboard) {
        switch (m) {
            case WM_KEYDOWN:
            case WM_KEYUP:
            case WM_SYSKEYDOWN:
            case WM_SYSKEYUP:
            case WM_CHAR:
            case WM_DEADCHAR:
            case WM_SYSCHAR:
                if (w == VK_OEM_3) break;
                return 0;
        }
    }
    
    if (g_ShowMenu) { 
        ImGui_ImplWin32_WndProcHandler(h,m,w,l); 
        return 1; 
    }
    return CallWindowProc(oWndProc, h, m, w, l);
}

// ==================== PRESENT HOOK ====================

HRESULT WINAPI hkPresent(IDirect3DDevice9* d, const RECT* s, const RECT* dt, HWND hw, const RGNDATA* r) {
    if (!g_ImguiInit) {
        g_Device = d; 
        D3DDEVICE_CREATION_PARAMETERS cp; 
        d->GetCreationParameters(&cp);
        oWndProc = (WNDPROC)SetWindowLongPtr(cp.hFocusWindow, GWLP_WNDPROC, (LONG_PTR)WndProc);
        ImGui::CreateContext(); 
        ImGui_ImplWin32_Init(cp.hFocusWindow); 
        ImGui_ImplDX9_Init(d);
        g_ImguiInit = true;
    }
    ImGui_ImplDX9_NewFrame(); 
    ImGui_ImplWin32_NewFrame(); 
    ImGui::NewFrame();
    ImGui::GetIO().MouseDrawCursor = g_ShowMenu;
    RunEngineLogic(); 
    DrawESP(); 
    DrawMenu();
    ImGui::EndFrame(); 
    ImGui::Render(); 
    ImGui_ImplDX9_RenderDrawData(ImGui::GetDrawData());
    return oPresent(d, s, dt, hw, r);
}

// ==================== MAIN THREAD ====================

DWORD WINAPI MainThread(LPVOID lp) {
    ResolveAPIs();
    API.Sleep(1000);
    g_Base = GetModuleBaseManual(NULL); 
    LoadConfig();
    MH_Initialize();
    
    // Hook ProcessEvent
    int retries = 0;
    while (retries++ < 50) {
        uintptr_t gobjects = *(uintptr_t*)(g_Base + 0x2207330);
        if (ValidPtr(gobjects)) {
            uintptr_t firstObject = *(uintptr_t*)gobjects;
            if (ValidPtr(firstObject)) {
                uintptr_t vtable = *(uintptr_t*)firstObject;
                if (ValidPtr(vtable)) {
                    uintptr_t processEventAddr = *(uintptr_t*)(vtable + 0x218);
                    if (ValidPtr(processEventAddr)) {
                        MH_CreateHook((LPVOID)processEventAddr, &hkProcessEvent, (LPVOID*)&oProcessEvent);
                        break;
                    }
                }
            }
        }
        API.Sleep(100);
    }
    
    // Hook D3D9 Present
    IDirect3D9* pD3D = Direct3DCreate9(D3D_SDK_VERSION);
    D3DPRESENT_PARAMETERS dp = {0}; 
    dp.Windowed = TRUE; 
    dp.SwapEffect = D3DSWAPEFFECT_DISCARD; 
    dp.hDeviceWindow = GetForegroundWindow();
    IDirect3DDevice9* dev = NULL; 
    pD3D->CreateDevice(0, D3DDEVTYPE_HAL, dp.hDeviceWindow, D3DCREATE_SOFTWARE_VERTEXPROCESSING, &dp, &dev);
    MH_CreateHook((*(void***)dev)[17], &hkPresent, (LPVOID*)&oPresent); 
    MH_EnableHook(MH_ALL_HOOKS);
    dev->Release(); 
    pD3D->Release();
    return 0;
}

BOOL WINAPI DllMain(HINSTANCE h, DWORD r, LPVOID l) { 
    if (r == 1) CreateThread(0,0,MainThread,0,0,0); 
    return 1; 
}

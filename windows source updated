__forceinline FVector RotateVector(FVector v, float qx, float qy, float qz, float qw) {
    FVector qv = { qx, qy, qz };
    FVector t = {
        2.0f * (qv.y * v.z - qv.z * v.y),
        2.0f * (qv.z * v.x - qv.x * v.z),
        2.0f * (qv.x * v.y - qv.y * v.x)
    };
    return {
        v.x + qw * t.x + (qv.y * t.z - qv.z * t.y),
        v.y + qw * t.y + (qv.z * t.x - qv.x * t.z),
        v.z + qw * t.z + (qv.x * t.y - qv.y * t.x)
    };
}

__forceinline FVector Cross(const FVector& a, const FVector& b) {
    return { a.y * b.z - a.z * b.y, a.z * b.x - a.x * b.z, a.x * b.y - a.y * b.x };
}

__forceinline FVector Normalize(const FVector& v) {
    float len = sqrtf(v.x * v.x + v.y * v.y + v.z * v.z);
    if (len < 0.001f) return v;
    return { v.x / len, v.y / len, v.z / len };
}

__forceinline float URotToDeg(int32_t rot) {
    return (float)rot * 360.0f / 65536.0f;
}

// --- Stealth Core: XOR Strings ---
template <int N>
class XorStr {
public:
    char data[N];
    static const char key = 0x7F;
    __forceinline XorStr(const char* s) { for (int i = 0; i < N; i++) data[i] = s[i] ^ key; }
    __forceinline char* decrypt() { for (int i = 0; i < N; i++) data[i] ^= key; return data; }
};
#define X(str) (XorStr<sizeof(str)>(str).decrypt())


FVector GetBoneLocation(uintptr_t pawn, int boneIdx) {
    __try {
        uintptr_t mesh = *(uintptr_t*)(pawn + 0x440); 
        if (!ValidPtr(mesh)) return {0,0,0};
        uintptr_t spaceBases = *(uintptr_t*)(mesh + 0x2FC);
        if (!ValidPtr(spaceBases)) return {0,0,0};
        FBoneAtom bone = *(FBoneAtom*)(spaceBases + (boneIdx * 32));
        FBoneAtom ctw = *(FBoneAtom*)(mesh + 0x720); 
        FVector localPos = { bone.tx, bone.ty, bone.tz };
        FVector world = RotateVector(localPos, ctw.x, ctw.y, ctw.z, ctw.w);
        return {
            (world.x * ctw.scale) + ctw.tx,
            (world.y * ctw.scale) + ctw.ty,
            (world.z * ctw.scale) + ctw.tz
        };
    } __except(1) { return {0,0,0}; }
}

FVector GetDynamicAimPoint(uintptr_t pawn, int targetBone) {
    __try {
        FVector loc = *(FVector*)(pawn + 0x330);
        
        switch(targetBone) {
            case 0: {
                FVector headBone = GetBoneLocation(pawn, 0);
                if (headBone.x != 0 || headBone.y != 0) return headBone;
                float eyeH = *(float*)(pawn + 0x800);
                if (eyeH < 5.0f || eyeH > 100.0f) {
                    float baseE = *(float*)(pawn + 0x7FC);
                    eyeH = (baseE > 5.0f && baseE < 100.0f) ? baseE : 64.0f;
                }
                return { loc.x, loc.y, loc.z + eyeH };
            }
            case 1: {
                FVector chestBone = GetBoneLocation(pawn, 3);
                if (chestBone.x != 0 || chestBone.y != 0) return chestBone;
                float eyeH = *(float*)(pawn + 0x800);
                if (eyeH < 5.0f || eyeH > 100.0f) {
                    float baseE = *(float*)(pawn + 0x7FC);
                    eyeH = (baseE > 5.0f && baseE < 100.0f) ? baseE : 64.0f;
                }
                return { loc.x, loc.y, loc.z + (eyeH * 0.5f) };
            }
            case 2:
                return loc;
            case 3:
            default: {
                float eyeH = *(float*)(pawn + 0x800);
                if (eyeH < 5.0f || eyeH > 100.0f) {
                    float baseE = *(float*)(pawn + 0x7FC);
                    eyeH = (baseE > 5.0f && baseE < 100.0f) ? baseE : 64.0f;
                }
                return { loc.x, loc.y, loc.z + eyeH + g_ZOffset };
            }
        }
    } __except(1) { 
        return {0,0,0}; 
    }
}


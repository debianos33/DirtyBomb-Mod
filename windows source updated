// ==================== MAIN GAME LOGIC ====================

void RunEngineLogic() {
    if (!API.GetTickCount) return;
    __try {
        if (!g_Base) g_Base = GetModuleBaseManual(NULL);
        uintptr_t world = *(uintptr_t*)(g_Base + GWORLD_OFFSET);
        if (!ValidPtr(world)) { ResetState(); g_LastWorld = 0; return; }
        if (world != g_LastWorld) { ResetState(); g_LastWorld = world; g_MapStartTime = API.GetTickCount(); return; }
        if (API.GetTickCount() - g_MapStartTime < 8000) return;

        uintptr_t level = *(uintptr_t*)(world + 0x80);
        if (!ValidPtr(level)) return;
        uintptr_t root = *(uintptr_t*)(g_Base + EXCEPTION_INFO_PTR);
        if (!ValidPtr(root)) return;
        uintptr_t lpArray = *(uintptr_t*)(root + 0x750);
        if (!ValidPtr(lpArray)) return;
        uintptr_t lp = *(uintptr_t*)lpArray;
        if (!ValidPtr(lp)) return;
        g_PC = *(uintptr_t*)(lp + 0x68);
        if (!ValidPtr(g_PC)) return;

        if (!g_OffsetsFound) FindOffsets();

        uintptr_t worldInfoPtr = *(uintptr_t*)(level + 0x60);
        if (!ValidPtr(worldInfoPtr)) return;
        uintptr_t worldInfo = *(uintptr_t*)worldInfoPtr; 
        if (!ValidPtr(worldInfo)) return;
        g_WorldInfo = worldInfo;

        // Find local pawn
        uintptr_t lpPawn = 0;
        if (!SafeRead(g_PC + ASGPLAYERCONTROLLER_SGPAWN, &lpPawn) || !ValidPtr(lpPawn)) {
            // Fallback: iterate to find pawn with matching controller
            uintptr_t cp_ = 0;
            if (SafeRead(worldInfo + 0x884, &cp_)) {
                int safety = 0;
                while (ValidPtr(cp_) && safety++ < 400) {
                    uintptr_t controller = 0;
                    if (SafeRead(cp_ + 0x388, &controller) && controller == g_PC) {
                        lpPawn = cp_;
                        break;
                    }
                    uintptr_t next = 0;
                    if (!SafeRead(cp_ + 0x710, &next)) break;
                    cp_ = next;
                }
            }
        }

        int myTeam = -1; 
        g_LocalPawn = lpPawn;
        if (ValidPtr(lpPawn)) {
             myTeam = GetPawnTeam(lpPawn);
             if (g_InfiniteLongJump) { 
                 __try { *(float*)(lpPawn + 0x1A30) = 0.0f; } __except(1) {} 
             }
             
             if (g_SkinChangerEnabled) {
                 ApplySkinChanger();
             }
        }
        
        // Build enemy lists for TP
        BuildEnemyLists();
        
        // ==================== CHAT SPAMMER ====================
        if (g_ChatSpammerEnabled && ValidPtr(g_PC)) {
            DWORD now = API.GetTickCount();
            if ((now - g_LastChatSpamTime) >= (DWORD)(g_ChatSpamDelay * 1000.0f)) {
                g_LastChatSpamTime = now;
                
                char cmd[350];
                const char* messageToSend;
                
                if (g_ChatSpamFunnyMode) {
                    messageToSend = g_FunnyMessages[rand() % g_FunnyMessagesCount];
                } else {
                    messageToSend = g_ChatSpamMessage;
                }
                
                if (g_ChatSpamRandomize) {
                    char prefix[5];
                    char suffix[5];
                    GenerateRandomString(prefix, 4);
                    GenerateRandomString(suffix, 4);
                    sprintf_s(cmd, "say [%s] %s [%s]", prefix, messageToSend, suffix);
                } else {
                    sprintf_s(cmd, "say %s", messageToSend);
                }
                
                ExecuteConsoleCommand(cmd);
                g_ChatSpamCount++;
            }
        }
        
        // ==================== CLAN TAG CHANGER ====================
        if (g_ClanTagEnabled && ValidPtr(g_PC)) {
            DWORD now = API.GetTickCount();
            
            if (g_ClanTagRandomMode) {
                if ((now - g_LastClanTagChange) >= (DWORD)(g_ClanTagRotateInterval * 1000.0f)) {
                    g_LastClanTagChange = now;
                    g_CurrentClanTagIndex = (g_CurrentClanTagIndex + 1) % g_ClanTagCount;
                    
                    char cmd[64];
                    sprintf_s(cmd, "setclantag %s", g_ClanTagList[g_CurrentClanTagIndex]);
                    ExecuteConsoleCommand(cmd);
                }
            } else {
                static bool tagSetThisSession = false;
                static bool wasEnabled = false;
                
                if (g_ClanTagEnabled && !wasEnabled) {
                    tagSetThisSession = false;
                }
                wasEnabled = g_ClanTagEnabled;
                
                if (!tagSetThisSession) {
                    tagSetThisSession = true;
                    char cmd[64];
                    sprintf_s(cmd, "setclantag %s", g_ClanTagSingle);
                    ExecuteConsoleCommand(cmd);
                }
            }
        }

        // ==================== VOTE-KICK DODGE (Linux-style) ====================
        CheckVoteKickDodge();

        if (ValidPtr(g_PC)) {
            SetThirdPerson(g_ThirdPerson);
            if (g_InfiniteLongJump) { 
                __try { *(uint8_t*)(g_PC + 0x1450) |= 1; } __except(1) {} 
            }
        }

        // Build view-projection matrix
        static int viewProjSkipCounter = 0;
        if (g_EspEnabled && (++viewProjSkipCounter >= 5 || !g_ViewProjValid)) {
            viewProjSkipCounter = 0;
            BuildViewProj();
        }

        FVector myLoc = {0,0,0}; 
        FRotator myRot = {0,0,0};
        GetPlayerViewPoint(myLoc, myRot);
        
        // YawOff detection
        static int yawOffScanSkip = 0;
        if (g_YawOff == 0 && myRot.yaw != 0 && ++yawOffScanSkip >= 30) {
            yawOffScanSkip = 0;
            for (int o = 0x80; o < 0x800; o += 4) {
                if (*(int*)(g_PC + o) == myRot.yaw) { 
                    g_YawOff = o; 
                    break; 
                }
            }
        }
        
        if (g_YawOff == 0) {
            g_EnemyCount = 0;
        }

        // ==================== PAWN ESP CACHE ====================
        g_PawnCache.clear();
        g_PawnCache.reserve(64);
        uintptr_t currentPawn = 0;
        SafeRead(worldInfo + 0x884, &currentPawn);
        uintptr_t bestT = 0; 
        float bestD = 999999.0f; 
        FVector tPos = {0,0,0};
        
        int s = 0;
        int foundCount = 0;
        float wTime = *(float*)(worldInfo + 0x79C);

        while (ValidPtr(currentPawn) && s++ < 400) {
            __try {
                if (currentPawn == lpPawn) { 
                    SafeRead(currentPawn + 0x710, &currentPawn); 
                    continue; 
                }
                
                if (!IsPawnAlive(currentPawn)) { 
                    SafeRead(currentPawn + 0x710, &currentPawn); 
                    continue; 
                }
                
                int hp = 0;
                SafeRead(currentPawn + 0x81C, &hp);

                int team = GetPawnTeam(currentPawn);
                bool isEnemy = (team != myTeam || team == -1);
                if (g_TeamCheck && !isEnemy && !g_EspTeammates) { 
                    SafeRead(currentPawn + 0x710, &currentPawn); 
                    continue; 
                }

                bool isVisible = true;
                if (g_VisibleCheck) {
                    uintptr_t mesh = 0;
                    SafeRead(currentPawn + 0x8E4, &mesh);
                    if (ValidPtr(mesh)) {
                        float rTime = 0.0f;
                        SafeRead(mesh + 0x244, &rTime);
                        isVisible = (wTime - rTime < 0.25f && wTime - rTime > -0.25f);
                    } else isVisible = false;
                }

                FVector loc = {0,0,0};
                if (!SafeReadFVector(currentPawn + 0x330, &loc)) {
                    SafeReadFVector(currentPawn + 0x44, &loc);
                }
                if (loc.x == 0 && loc.y == 0 && loc.z == 0) {
                    SafeRead(currentPawn + 0x710, &currentPawn);
                    continue;
                }
                
                int fullHeight = 0;
                SafeRead(currentPawn + 0x73C, &fullHeight);
                float cylinderHalfHeight = (fullHeight > 0 && fullHeight < 200) ? (float)fullHeight / 2.0f : 44.0f;
                
                FVector feetPos = { loc.x, loc.y, loc.z - cylinderHalfHeight };
                FVector headPosVec = { loc.x, loc.y, loc.z + cylinderHalfHeight };
                
                Vector2 centerScreen, feetScreen, headScreen;
                bool centerOk = WorldToScreen(loc, centerScreen);
                bool feetOk = WorldToScreen(feetPos, feetScreen);
                bool headOk = WorldToScreen(headPosVec, headScreen);
                
                if (centerOk && feetOk && headOk) {
                    CachedPawn cp;
                    
                    cp.screenCenter = ImVec2(centerScreen.x, centerScreen.y);
                    cp.sBase = ImVec2(feetScreen.x, feetScreen.y);
                    cp.sHead = ImVec2(headScreen.x, headScreen.y);
                    
                    float boxHeight = fabsf(cp.sBase.y - cp.sHead.y);
                    float boxWidth = boxHeight * 0.5f;
                    
                    cp.boxMin = ImVec2(cp.screenCenter.x - boxWidth / 2.0f, cp.sHead.y);
                    cp.boxMax = ImVec2(cp.screenCenter.x + boxWidth / 2.0f, cp.sBase.y);
                    
                    cp.hp = hp; 
                    int hpMax = 0;
                    SafeRead(currentPawn + 0x820, &hpMax);
                    cp.hpMax = hpMax;
                    cp.team = team; 
                    cp.isEnemy = isEnemy; 
                    cp.isVisible = isVisible;
                    cp.isDowned = false;
                    cp.pawnPtr = currentPawn;
                    
                    strcpy_s(cp.name, "Player");
                    if (g_NameCacheFrameCounter == 0) {
                        bool foundName = false;
                        for (auto& nc : g_PawnNames) {
                            if (nc.pawnPtr == currentPawn) {
                                strcpy_s(cp.name, nc.name);
                                foundName = true;
                                break;
                            }
                        }
                        
                        if (!foundName) {
                            uintptr_t pri = 0;
                            SafeRead(currentPawn + 0x3F0, &pri);
                            if (!ValidPtr(pri)) SafeRead(currentPawn + 0x898, &pri);
                            if (ValidPtr(pri)) {
                                char tempName[64];
                                ReadFString(pri + 0x538, tempName, 64);
                                if (tempName[0] != '\0') {
                                    strcpy_s(cp.name, tempName);
                                    
                                    PawnNameCache nc;
                                    nc.pawnPtr = currentPawn;
                                    strcpy_s(nc.name, tempName);
                                    nc.lastUpdate = API.GetTickCount();
                                    g_PawnNames.push_back(nc);
                                }
                            }
                        }
                    } else {
                        for (auto& nc : g_PawnNames) {
                            if (nc.pawnPtr == currentPawn) {
                                strcpy_s(cp.name, nc.name);
                                break;
                            }
                        }
                    }
                    
                    g_PawnCache.push_back(cp);
                }

                // Aimbot target selection
                if ((isEnemy || !g_TeamCheck) && g_AimbotEnabled) {
                    if (g_VisibleCheck && !isVisible) { 
                        SafeRead(currentPawn + 0x710, &currentPawn); 
                        continue; 
                    }
                    
                    if (hp <= 0) { 
                        SafeRead(currentPawn + 0x710, &currentPawn); 
                        continue; 
                    }
                    
                    foundCount++;
                    
                    FVector aimPoint = GetDynamicAimPoint(currentPawn, g_AimTargetBone);
                    if (aimPoint.x == 0 && aimPoint.y == 0 && aimPoint.z == 0) {
                        aimPoint = GetDynamicAimPoint(currentPawn, 3);
                    }
                    
                    FVector vel = {0,0,0};
                    SafeReadFVector(currentPawn + 0x15c, &vel);
                    float predFactor = 0.040f; 
                    FVector pLoc = { 
                        aimPoint.x + (vel.x * predFactor), 
                        aimPoint.y + (vel.y * predFactor), 
                        aimPoint.z + (vel.z * predFactor) 
                    };
                    
                    if (isnan(pLoc.x) || isnan(pLoc.y) || isnan(pLoc.z) || 
                        isinf(pLoc.x) || isinf(pLoc.y) || isinf(pLoc.z)) {
                        SafeRead(currentPawn + 0x710, &currentPawn); 
                        continue;
                    }

                    float dx = pLoc.x - myLoc.x, dy = pLoc.y - myLoc.y, dz = pLoc.z - myLoc.z;
                    
                    if (isnan(dx) || isnan(dy) || isnan(dz) || isinf(dx) || isinf(dy) || isinf(dz)) {
                        SafeRead(currentPawn + 0x710, &currentPawn); 
                        continue;
                    }
                    
                    float yawReq = atan2f(dy, dx) * 57.2957f;
                    float pitchReq = atan2f(dz, sqrtf(dx*dx + dy*dy)) * 57.2957f;
                    float mY = (float)myRot.yaw / (UR_UNITS / 57.2957f);
                    float mP = (float)myRot.pitch / (UR_UNITS / 57.2957f);
                    float dY = fabsf(yawReq - mY); if (dY > 180.0f) dY = fabsf(360.0f - dY);
                    float dP = fabsf(pitchReq - mP);

                    float aimFov = g_FovCircleRadius * 0.075f;
                    if (dY < aimFov && dP < aimFov) {
                        float d = sqrtf(dx * dx + dy * dy + dz * dz);
                        if (d < bestD && d > 0.1f && d < 50000.0f) {
                            bestD = d; 
                            bestT = currentPawn; 
                            tPos = pLoc;
                        }
                    }
                }
            } __except(1) {}
            uintptr_t nextPawn = 0;
            if (!SafeRead(currentPawn + 0x710, &nextPawn)) break;
            currentPawn = nextPawn;
        }
        g_EnemyCount = foundCount;

        // ==================== AIMBOT ====================
        bool isKeyDown = (API.GetAsyncKeyState(g_AimKey) & 0x8000) != 0;
        bool justPressed = isKeyDown && !g_WasKeyDown;
        g_WasKeyDown = isKeyDown;

        // Bone toggle
        bool isBoneToggleKeyDown = (API.GetAsyncKeyState(g_BoneToggleKey) & 0x8000) != 0;
        bool justBoneTogglePressed = isBoneToggleKeyDown && !g_BoneToggleKeyWasDown;
        g_BoneToggleKeyWasDown = isBoneToggleKeyDown;
        
        if (justBoneTogglePressed) {
            if (g_AimTargetBone == 0) {
                g_AimTargetBone = g_SavedBoneMode;
            } else {
                g_SavedBoneMode = g_AimTargetBone;
                g_AimTargetBone = 0;
            }
        }

        // ==================== TP LOGIC ====================
        bool inputBlocked = IsConsoleBlockingInput();
        bool isTpKeyDown = !inputBlocked && ((API.GetAsyncKeyState(g_TpKey) & 0x8000) != 0);
        bool justTpPressed = isTpKeyDown && !g_TpWasKeyDown;
        g_TpWasKeyDown = isTpKeyDown;
        
        // Update current TP target for FOV mode
        if (g_TpEnabled && g_TpMode == 0) {
            g_CurrentTpTarget = GetClosestEnemyInFOV(myLoc, myRot);
        } else {
            g_CurrentTpTarget = 0;
        }
        
        DWORD now = API.GetTickCount();
        
        // Continuous follow for TP modes
        if (!inputBlocked && g_TpActive && (now - g_LastLocationCheck) >= 50) {
            g_LastLocationCheck = now;
            bool isMovementKeyPressed = 
                (API.GetAsyncKeyState('W') & 0x8000) || 
                (API.GetAsyncKeyState('A') & 0x8000) || 
                (API.GetAsyncKeyState('S') & 0x8000) || 
                (API.GetAsyncKeyState('D') & 0x8000);
            
            if (isMovementKeyPressed) {
                g_TpActive = false;
                g_LastPlayerLocation = myLoc;
            } else {
                uintptr_t targetToFollow = 0;
                
                if (g_TpMode == 0) {
                    targetToFollow = g_CurrentTpTarget;
                } else if (g_TpMode == 1) {
                    targetToFollow = g_RandomEnemyTarget;
                } else if (g_TpMode == 4) {
                    targetToFollow = g_AutoRandomTpTarget;
                } else if (g_TpMode == 5) {
                    targetToFollow = g_AutoRandomTp2Target;
                }
                
                if (ValidPtr(targetToFollow)) {
                    FVector targetLoc;
                    if (SafeReadFVector(targetToFollow + ACTOR_LOCATION, &targetLoc)) {
                        TeleportPlayer(lpPawn, targetLoc);
                    }
                }
            }
        }
        
        // ==================== AUTO RANDOM TP MODE 4 (on kill) ====================
        if (!inputBlocked && g_TpEnabled && g_TpMode == 4 && g_AutoRandomTpEnabled) {
            bool needNewTarget = false;

            if (!ValidPtr(g_AutoRandomTpTarget)) {
                needNewTarget = true;
            } else {
                bool alive = IsPawnAlive(g_AutoRandomTpTarget);
                bool inPool = false;
                for (uintptr_t p : g_RandomTpPool) {
                    if (p == g_AutoRandomTpTarget) { inPool = true; break; }
                }
                if (!alive || !inPool) {
                    needNewTarget = true;
                }
            }

            if (needNewTarget) {
                uintptr_t t = 0;
                if (!g_RandomTpPool.empty()) {
                    t = g_RandomTpPool[rand() % g_RandomTpPool.size()];
                }
                if (ValidPtr(t)) {
                    FVector tloc;
                    if (SafeReadFVector(t + ACTOR_LOCATION, &tloc)) {
                        TeleportPlayer(lpPawn, tloc);
                        OrientAtTarget(lpPawn, tloc);
                        g_AutoRandomTpTarget   = t;
                        g_AutoRandomTpWasAlive = true;
                        g_TpActive             = true;
                        g_LastLocationCheck    = now;
                    }
                }
            }
        } else {
            if (g_TpMode != 4) {
                g_AutoRandomTpTarget   = 0;
                g_AutoRandomTpWasAlive = false;
            }
            if (g_TpMode == 4) g_TpActive = false;
        }

        // ==================== AUTO RANDOM TP MODE 5 (timed) ====================
        if (!inputBlocked && g_TpEnabled && g_TpMode == 5 && g_AutoRandomTp2Enabled) {
            DWORD ivMs = (DWORD)(g_AutoRandomTp2Interval * 1000.0f);
            if (ivMs < 1000) ivMs = 1000;
            if (ivMs > 5000) ivMs = 5000;

            if ((now - g_LastAutoRandomTp2) >= ivMs) {
                uintptr_t t = GetRandomTargetExcluding(g_AutoRandomTp2Target, &g_AutoRandomTp2Target);
                if (ValidPtr(t)) {
                    FVector tloc;
                    if (SafeReadFVector(t + ACTOR_LOCATION, &tloc)) {
                        TeleportPlayer(lpPawn, tloc);
                        OrientAtTarget(lpPawn, tloc);
                        g_LastAutoRandomTp2 = now;
                        g_TpActive          = true;
                        g_LastLocationCheck = now;
                    }
                }
            }
        } else {
            if (g_TpMode != 5) {
                g_LastAutoRandomTp2 = 0;
            }
            if (g_TpMode == 5) g_TpActive = false;
        }
        
        // ==================== TP ACTIVATION ====================
        if (!inputBlocked && g_TpEnabled && justTpPressed) {
            if ((now - g_LastTpTime) > (DWORD)(g_TpCooldown * 1000.0f)) {
                g_LastTpTime = now;
                
                uintptr_t tpTarget = 0;
                FVector tpLoc = {0,0,0};
                
                switch (g_TpMode) {
                    case 0: {
                        tpTarget = GetClosestEnemyInFOV(myLoc, myRot);
                        if (ValidPtr(tpTarget)) {
                            SafeReadFVector(tpTarget + ACTOR_LOCATION, &tpLoc);
                            PerformTP(lpPawn, tpLoc);
                            g_CurrentTpTarget = tpTarget;
                            g_TpActive = true;
                            g_LastPlayerLocation = myLoc;
                            g_LastLocationCheck = now;
                        }
                        break;
                    }
                    case 1: {
                        tpTarget = GetRandomTarget();
                        if (ValidPtr(tpTarget)) {
                            SafeReadFVector(tpTarget + ACTOR_LOCATION, &tpLoc);
                            PerformTP(lpPawn, tpLoc);
                            g_TpActive = true;
                            g_LastPlayerLocation = myLoc;
                            g_LastLocationCheck = now;
                        } else {
                            g_TpActive = false;
                        }
                        break;
                    }
                    case 2: {
                        tpTarget = GetRandomDownedTeammate(myTeam);
                        if (ValidPtr(tpTarget)) {
                            SafeReadFVector(tpTarget + ACTOR_LOCATION, &tpLoc);
                            PerformTP(lpPawn, tpLoc);
                            g_TpActive = false;
                        }
                        break;
                    }
                    case 3: {
                        FVector hitLoc = {0,0,0};
                        uintptr_t hitActor = 0;
                        if (GetCrosshairTraceData(g_PC, hitLoc, hitActor)) {
                            PerformTP(lpPawn, hitLoc);
                            g_TpActive = false;
                        }
                        break;
                    }
                    case 4: {
                        uintptr_t t = 0;
                        if (!g_RandomTpPool.empty()) {
                            t = g_RandomTpPool[rand() % g_RandomTpPool.size()];
                        }
                        if (ValidPtr(t)) {
                            SafeReadFVector(t + ACTOR_LOCATION, &tpLoc);
                            PerformTP(lpPawn, tpLoc);
                            g_AutoRandomTpTarget   = t;
                            g_AutoRandomTpWasAlive = true;
                            g_TpActive             = true;
                            g_LastLocationCheck    = now;
                        }
                        break;
                    }
                    case 5: {
                        uintptr_t t = GetRandomTargetExcluding(g_AutoRandomTp2Target, &g_AutoRandomTp2Target);
                        if (ValidPtr(t)) {
                            SafeReadFVector(t + ACTOR_LOCATION, &tpLoc);
                            PerformTP(lpPawn, tpLoc);
                            g_LastAutoRandomTp2 = now;
                            g_TpActive          = true;
                            g_LastLocationCheck = now;
                        }
                        break;
                    }
                }
            }
        }

        // ==================== AUTO SHOOT ====================
        if (!inputBlocked && g_AutoShootEnabled && ValidPtr(g_PC)) {
            __try {
                static bool s_ToggleState = false;
                static bool s_KeyWasDown = false;

                bool keyDown = (API.GetAsyncKeyState(g_AutoShootKey) & 0x8000) != 0;
                bool autoJustPressed = keyDown && !s_KeyWasDown;
                s_KeyWasDown = keyDown;

                bool active;
                if (g_AutoShootToggleMode) {
                    if (autoJustPressed) s_ToggleState = !s_ToggleState;
                    active = s_ToggleState;
                } else {
                    active = keyDown;
                }

                if (active) {
                    bool shouldShoot = true;
                    
                    if (g_AutoShootTeamCheck) {
                        uintptr_t tracePtr = g_PC + 0x1828;
                        bool traceValid = false;
                        SafeRead(tracePtr + 0x0, &traceValid);
                        
                        if (traceValid) {
                            uintptr_t hitActor = 0;
                            SafeRead(tracePtr + 0x4, &hitActor);
                            if (ValidPtr(hitActor)) {
                                int hitTeam = GetPawnTeam(hitActor);
                                if (hitTeam == myTeam && hitTeam != -1) {
                                    shouldShoot = false;
                                }
                            }
                        }
                    }
                    
                    if (shouldShoot) {
                        DWORD nowShoot = API.GetTickCount();
                        if ((nowShoot - g_LastAutoShootShot) >= (DWORD)g_AutoShootDelay) {
                            INPUT in = {0};
                            in.type = INPUT_MOUSE;
                            in.mi.dwFlags = MOUSEEVENTF_LEFTDOWN;
                            SendInput(1, &in, sizeof(INPUT));
                            in.mi.dwFlags = MOUSEEVENTF_LEFTUP;
                            SendInput(1, &in, sizeof(INPUT));
                            g_LastAutoShootShot = nowShoot;
                        }
                    }
                }
            } __except(1) {}
        }

        // ==================== REAL TRIGGERBOT ====================
        if (!inputBlocked && g_RealTriggerbotEnabled && ValidPtr(g_PC)) {
            __try {
                bool isRealTriggerKeyDown = (API.GetAsyncKeyState(g_RealTriggerbotKey) & 0x8000) != 0;
                
                if (isRealTriggerKeyDown) {
                    uintptr_t tracePtr = g_PC + 0x1828;
                    bool traceValid = false;
                    SafeRead(tracePtr + 0x0, &traceValid);
                    
                    if (traceValid) {
                        uintptr_t hitActor = 0;
                        SafeRead(tracePtr + 0x4, &hitActor);
                        
                        if (ValidPtr(hitActor)) {
                            int hitTeam = GetPawnTeam(hitActor);
                            bool isEnemy = (hitTeam != myTeam || hitTeam == -1);
                            
                            if (!g_RealTriggerbotTeamCheck || isEnemy) {
                                DWORD nowShoot = API.GetTickCount();
                                if ((nowShoot - g_LastRealTriggerbotShot) >= (DWORD)g_RealTriggerbotDelay) {
                                    INPUT in = {0};
                                    in.type = INPUT_MOUSE;
                                    in.mi.dwFlags = MOUSEEVENTF_LEFTDOWN;
                                    SendInput(1, &in, sizeof(INPUT));
                                    in.mi.dwFlags = MOUSEEVENTF_LEFTUP;
                                    SendInput(1, &in, sizeof(INPUT));
                                    g_LastRealTriggerbotShot = nowShoot;
                                }
                            }
                        }
                    }
                }
            } __except(1) {}
        }

        // ==================== DEFIB AUTO-REVIVE ====================
        if (!inputBlocked && g_DefibAutoRevive && ValidPtr(g_PC)) {
            __try {
                bool isTriggerKeyDown = 
                    (API.GetAsyncKeyState(g_AutoShootKey) & 0x8000) || 
                    (API.GetAsyncKeyState(g_RealTriggerbotKey) & 0x8000);
                
                if (isTriggerKeyDown) {
                    uintptr_t tracePtr = g_PC + 0x1828;
                    bool traceValid = false;
                    SafeRead(tracePtr + 0x0, &traceValid);
                    
                    if (traceValid) {
                        uintptr_t hitActor = 0;
                        SafeRead(tracePtr + 0x4, &hitActor);
                        
                        if (ValidPtr(hitActor)) {
                            int hitTeam = GetPawnTeam(hitActor);
                            bool isTeammate = (hitTeam == myTeam && hitTeam != -1);
                            
                            if (isTeammate && IsPawnDowned(hitActor)) {
                                DWORD nowClick = API.GetTickCount();
                                if ((nowClick - g_LastAutoShootShot) >= 50) {
                                    INPUT in = {0};
                                    in.type = INPUT_MOUSE;
                                    in.mi.dwFlags = MOUSEEVENTF_LEFTDOWN;
                                    SendInput(1, &in, sizeof(INPUT));
                                    in.mi.dwFlags = MOUSEEVENTF_LEFTUP;
                                    SendInput(1, &in, sizeof(INPUT));
                                    g_LastAutoShootShot = nowClick;
                                }
                            }
                        }
                    }
                }
            } __except(1) {}
        }

        // ==================== AIMBOT EXECUTION ====================
        if (bestT && g_YawOff && ValidPtr(g_PC)) {
            bool valid = !isnan(tPos.x) && !isnan(tPos.y) && !isnan(tPos.z) &&
                         !isnan(myLoc.x) && !isnan(myLoc.y) && !isnan(myLoc.z) &&
                         ValidPtr(bestT);
            
            if (valid) {
                float dx = tPos.x - myLoc.x, dy = tPos.y - myLoc.y, dz = tPos.z - myLoc.z;
                float d2d = sqrtf(dx * dx + dy * dy);
                
                if (d2d > 0.1f && d2d < 100000.0f) {
                    int targetYaw = (int)(atan2f(dy, dx) * UR_UNITS) - 27;
                    int targetPitch = (int)(atan2f(dz, d2d) * UR_UNITS);
            
                    if (g_SilentAim) {
                        DWORD nowAim = API.GetTickCount();
                        if (justPressed && (nowAim - g_LastSilentAimTime) > g_SilentAimCooldown) {
                            __try {
                                if (ValidPtr(g_PC) && g_YawOff > 0) {
                                    int testRead = *(int*)(g_PC + g_YawOff);
                                    *(int*)(g_PC + g_YawOff) = targetYaw;
                                    *(int*)(g_PC + g_YawOff - 4) = targetPitch;
                                    g_LastSilentAimTime = nowAim;
                                }
                            } __except(1) {
                                g_YawOff = 0;
                                bestT = 0;
                            }
                        }
                    } else if (isKeyDown) {
                        __try {
                            if (g_Smoothing <= 1.05f) {
                                *(int*)(g_PC + g_YawOff) = targetYaw;
                                *(int*)(g_PC + g_YawOff - 4) = targetPitch;
                            } else {
                                int curY = *(int*)(g_PC + g_YawOff), curP = *(int*)(g_PC + g_YawOff - 4);
                                int diffY = targetYaw - curY, diffP = targetPitch - curP;
                                if (diffY > 32768) diffY -= 65536; 
                                if (diffY < -32768) diffY += 65536;
                                float f = 1.0f / g_Smoothing;
                                if (g_SmoothType == 1) {
                                    float dist = sqrtf((float)diffY * diffY + (float)diffP * diffP);
                                    float t = dist / 2000.0f; 
                                    if (t > 1.0f) t = 1.0f;
                                    f *= (0.2f + (1.0f / (1.0f + expf(-10.0f * (t - 0.5f)))) * 0.8f);
                                }
                                if (g_AimJitter > 0.1f) { 
                                    diffY += (rand() % 20 - 10); 
                                    diffP += (rand() % 20 - 10); 
                                }
                                *(int*)(g_PC + g_YawOff) = curY + (int)((float)diffY * f);
                                *(int*)(g_PC + g_YawOff - 4) = curP + (int)((float)diffP * f);
                            }
                        } __except(1) {
                            g_YawOff = 0;
                        }
                    }
                }
            }
        }

        // ==================== WEAPON MODS ====================
        if (ValidPtr(lpPawn)) {
            uintptr_t weapon = 0;
            SafeRead(lpPawn + APAWN_WEAPON, &weapon);
            
            if (ValidPtr(weapon)) {
                // Viewmodel
                SafeWriteFloat(weapon + 0x868, g_VmX);
                SafeWriteFloat(weapon + 0x86C, g_VmY);
                SafeWriteFloat(weapon + 0x870, g_VmZ);
                
                // ==================== ONE HIT KILL ====================
                if (g_ProjectilesPerShotEnabled) {
                    WriteTArrayInt32First(weapon + ASGWEAPON_PROJECTILESPERSSHOT,
                                          g_ProjectilesPerShotValue);
                }
                
                // ==================== RAPID FIRE ====================
                if (g_RapidFire) {
                    if (g_FireRate >= 0.001f && g_FireRate <= 10.0f && 
                        !isnan(g_FireRate) && !isinf(g_FireRate)) {
                        SafeWriteFloat(weapon + WEAPON_FIREINTERVALMODIFIED, g_FireRate);
                        SafeWriteFloat(weapon + WEAPON_NEXTFIRETIME, 0.0f);
                    }
                }
                
                // ==================== INFINITE AMMO ====================
                if (g_InfiniteAmmo) {
                    __try {
                        uintptr_t shotCostArray = weapon + 0x1658;
                        uintptr_t shotCostData = *(uintptr_t*)shotCostArray;
                        int shotCostCount = *(int*)(shotCostArray + 8);
                        
                        if (ValidPtr(shotCostData) && shotCostCount > 0 && shotCostCount < 10) {
                            for (int i = 0; i < shotCostCount && i < 4; i++) {
                                *(int32_t*)(shotCostData + (i * 4)) = 0;
                            }
                        }
                    } __except(1) {}
                }
                
                // ==================== DEFIB LEGACY ====================
                if (g_InstantDefibCharge) {
                    __try {
                        float currentCharge = *(float*)(weapon + 0x17d0);
                        if (currentCharge >= 0.0f && currentCharge <= 1.0f && 
                            !isnan(currentCharge) && !isinf(currentCharge)) {
                            *(float*)(weapon + 0x17d0) = 1.0f;
                            *(float*)(weapon + 0x17d4) = 1.0f;
                            
                            float currentRate = *(float*)(weapon + 0x1768);
                            if (currentRate >= 0.0f && currentRate < 10000.0f && 
                                !isnan(currentRate) && !isinf(currentRate)) {
                                *(float*)(weapon + 0x1768) = 999.0f;
                            }
                        }
                    } __except(1) {}
                }
                
                if (g_MaxDefibDamage) {
                    __try {
                        int minHealth = *(int32_t*)(weapon + 0x1760);
                        int maxHealth = *(int32_t*)(weapon + 0x1764);
                        
                        if (minHealth >= 0 && minHealth < 200 && maxHealth >= 0 && maxHealth < 200) {
                            if (minHealth > 0 || maxHealth > 0) {
                                *(int32_t*)(weapon + 0x1760) = 120;
                                *(int32_t*)(weapon + 0x1764) = 120;
                                
                                float reviveRange = *(float*)(weapon + 0x16a8);
                                float damageRange = *(float*)(weapon + 0x16ac);
                                
                                if (reviveRange >= 0.0f && reviveRange < 10000.0f && !isnan(reviveRange) && !isinf(reviveRange)) {
                                    *(float*)(weapon + 0x16a8) = 200.0f * g_DefibRangeMultiplier;
                                }
                                if (damageRange >= 0.0f && damageRange < 10000.0f && !isnan(damageRange) && !isinf(damageRange)) {
                                    *(float*)(weapon + 0x16ac) = 200.0f * g_DefibRangeMultiplier;
                                }
                            }
                        }
                    } __except(1) {}
                }
                
                // ==================== MELEE ENHANCEMENTS (Linux-style) ====================
                bool isMelee = false;
                SafeRead(weapon + AWEAPON_BMELEEWEAPON, &isMelee);
                
                // Fast melee
                if (g_FastMelee && isMelee) {
                    SafeWriteFloat(weapon + WEAPON_FIREINTERVALMODIFIED, g_MeleeFireInterval);
                    SafeWriteFloat(weapon + WEAPON_FIREINTERVALAUGMENTMOD, 0.0f);

                    uintptr_t fiData = 0;
                    int32_t fiCount = 0;
                    if (SafeRead(weapon + AWEAPON_FIREINTERVAL, &fiData) && ValidPtr(fiData)) {
                        if (SafeRead(weapon + AWEAPON_FIREINTERVAL_COUNT_OFF, &fiCount)) {
                            int maxWrite = (fiCount > 0 && fiCount < 8) ? fiCount : 2;
                            for (int i = 0; i < maxWrite; i++) {
                                SafeWriteFloat(fiData + (i * 4), g_MeleeFireInterval);
                            }
                        }
                    }

                    if (g_FastMeleeForceNextFire && g_MeleeFireInterval < 0.5f) {
                        SafeWriteFloat(weapon + WEAPON_NEXTFIRETIME, 0.0f);
                    }
                }
                
                // Melee range (Linux-style)
                if (g_MeleeRange && isMelee) {
                    uintptr_t proxy = 0;
                    bool proxyOk = false;
                    if (SafeRead(weapon + SGMELEE_M_CURRENTACTIVEPROXY, &proxy) && ValidPtr(proxy)) {
                        proxyOk = true;
                    } else if (SafeRead(weapon + SGMELEE_M_IMPACTPROXY, &proxy) && ValidPtr(proxy)) {
                        proxyOk = true;
                    }

                    if (proxyOk) {
                        uintptr_t collComp = 0;
                        if (SafeRead(proxy + IMPACTPROXY_MELECOLLISIONCOMP, &collComp) && ValidPtr(collComp)) {
                            SafeWriteFloat(collComp + PRIMCOMP_BOUNDSSCALE, g_MeleeBoundsScale);
                            if (g_MeleeVisualScale) {
                                float s = g_MeleeBoundsScale;
                                SafeWriteFloat(collComp + PRIMCOMP_SCALE, s);
                                SafeWriteVector3(collComp + PRIMCOMP_SCALE3D, s, s, s);
                            }
                            if (g_MeleeWideAngle)
                                SafeWriteFloat(weapon + SGMELEE_M_MAXIMPACTPROXYHITDOT, g_MeleeHitDot);

                            if (g_MeleePushForward && g_MeleeForwardOffset != 0.0f) {
                                ApplyMeleeForwardOffset(proxy, collComp, g_MeleeForwardOffset);
                            }
                        }
                    }
                }
                
                // Legacy melee enhancements
                if (g_MeleeEnhanced) {
                    __try {
                        float currentBackstabMult = *(float*)(weapon + 0x1634);
                        
                        if (currentBackstabMult >= 0.1f && currentBackstabMult < 1000.0f && 
                            !isnan(currentBackstabMult) && !isinf(currentBackstabMult) &&
                            g_BackstabMultiplier >= 1.0f && g_BackstabMultiplier <= 100.0f &&
                            !isnan(g_BackstabMultiplier) && !isinf(g_BackstabMultiplier)) {
                            
                            int safeAngle = (g_BackstabAngleSlider < 0) ? 0 : 
                                           (g_BackstabAngleSlider > 180) ? 180 : g_BackstabAngleSlider;
                            int ue3Angle = (int)((float)safeAngle * 182.044f);
                            
                            *(float*)(weapon + 0x1634) = g_BackstabMultiplier;
                            *(int32_t*)(weapon + 0x1630) = ue3Angle;
                            
                            if (g_MeleeReachMultiplier >= 1.0f && g_MeleeReachMultiplier <= 10.0f &&
                                !isnan(g_MeleeReachMultiplier) && !isinf(g_MeleeReachMultiplier)) {
                                float reachDot = 1.0f - (g_MeleeReachMultiplier * 0.05f);
                                if (reachDot < -1.0f) reachDot = -1.0f;
                                if (reachDot > 1.0f) reachDot = 1.0f;
                                *(float*)(weapon + 0x1678) = reachDot;
                            }
                        }
                    } __except(1) {}
                }
            }
            
            // No recoil
            if (g_NoRecoil) {
                __try {
                    *(int*)(lpPawn + 0x1ACC) = 0; 
                    *(int*)(lpPawn + 0x1AD0) = 0; 
                    *(int*)(lpPawn + 0x1AD4) = 0;
                } __except(1) {}
                
                SafeWriteFloat(weapon + WEAPON_SPREADRECOVERYTIME, 0.0f);
            }
            
            // No spread
            if (g_NoSpread) {
                SafeWriteFloat(weapon + 0x13dc, g_CustomSpreadValue);
                SafeWriteFloat(weapon + 0x13e0, g_CustomSpreadValue);
            }
        }
        
        g_DebugPawnCount = s;
        
        // Name cache frame counter
        g_NameCacheFrameCounter++;
        if (g_NameCacheFrameCounter >= NAME_CACHE_INTERVAL) g_NameCacheFrameCounter = 0;
        
        // Cache cleanup
        static int g_CacheCleanupCounter = 0;
        g_CacheCleanupCounter++;
        
        if (g_CacheCleanupCounter >= 600 && API.GetTickCount) {
            g_CacheCleanupCounter = 0;
            DWORD cleanupNow = API.GetTickCount();
            
            if (g_PawnNames.size() > 50) {
                int toRemove = g_PawnNames.size() - 30;
                if (toRemove > 0) {
                    g_PawnNames.erase(g_PawnNames.begin(), g_PawnNames.begin() + toRemove);
                }
            }
            
            auto it = g_PawnNames.begin();
            while (it != g_PawnNames.end() && g_PawnNames.size() > 10) {
                if ((cleanupNow - it->lastUpdate) > 8000) {
                    it = g_PawnNames.erase(it);
                } else {
                    ++it;
                }
            }
        }
    } __except(1) {}
}

// ==================== ESP ====================

void DrawESP() {
    if (!g_Device || !g_EspEnabled) return;
    
    __try {
        D3DVIEWPORT9 vp; 
        g_Device->GetViewport(&vp);
        if (g_FovCircleEnabled)
            ImGui::GetForegroundDrawList()->AddCircle(ImVec2((float)vp.Width / 2, (float)vp.Height / 2), g_FovCircleRadius, IM_COL32_WHITE, 100, 2);
    } __except(1) {
        return;
    }

    if (g_PawnCache.empty()) return;

    auto drawList = ImGui::GetForegroundDrawList();
    if (!drawList) return;
    
    int maxDraw = (g_PawnCache.size() < 100) ? (int)g_PawnCache.size() : 100;
    
    for (int idx = 0; idx < maxDraw; idx++) {
        const auto& cp = g_PawnCache[idx];
        ImU32 col;
        
        if (cp.isDowned && !cp.isEnemy) {
            col = IM_COL32(255, 165, 0, 255);
        }
        else if (g_TpEnabled && g_TpMode == 0 && cp.pawnPtr == g_CurrentTpTarget && cp.isEnemy) {
            col = IM_COL32(144, 238, 144, 255);
        }
        else if (!cp.isEnemy) {
            col = IM_COL32(0, 150, 255, 255);
        } else {
            if (g_VisibleCheck) {
                col = cp.isVisible ? IM_COL32(0, 255, 0, 255) : IM_COL32(255, 0, 0, 255);
            } else {
                col = IM_COL32(255, 0, 0, 255);
            }
        }

        if (g_EspBox) {
            drawList->AddRect(ImVec2(cp.boxMin.x, cp.boxMin.y), ImVec2(cp.boxMax.x, cp.boxMax.y), col);
        }
        
        if (g_EspTracers && g_Device) {
            D3DVIEWPORT9 vp; 
            g_Device->GetViewport(&vp);
            ImVec2 screenCenter = ImVec2((float)vp.Width / 2.0f, (float)vp.Height);
            drawList->AddLine(screenCenter, cp.screenCenter, col, 1.5f);
        }

        if (g_EspHealth) {
            float h = fabsf(cp.boxMax.y - cp.boxMin.y);
            float pct = (cp.hpMax > 0) ? (float)cp.hp / (float)cp.hpMax : 0.0f;
            if (pct > 1.0f) pct = 1.0f;
            ImU32 hpCol = IM_COL32(0, 255, 0, 255);
            if (pct < 0.3f) hpCol = IM_COL32(255, 0, 0, 255);
            else if (pct < 0.6f) hpCol = IM_COL32(255, 255, 0, 255);
            drawList->AddRectFilled(ImVec2(cp.boxMin.x - 6, cp.boxMin.y), ImVec2(cp.boxMin.x - 2, cp.boxMax.y), IM_COL32(0, 0, 0, 150));
            drawList->AddRectFilled(ImVec2(cp.boxMin.x - 5, cp.boxMax.y - (h * pct)), ImVec2(cp.boxMin.x - 3, cp.boxMax.y), hpCol);
        }
        
        if (g_EspNames && cp.name[0] != '\0' && strcmp(cp.name, "Unknown") != 0) {
            ImVec2 textSize = ImGui::CalcTextSize(cp.name);
            ImVec2 namePos = ImVec2((cp.boxMin.x + cp.boxMax.x) / 2.0f - textSize.x / 2.0f, cp.boxMin.y - 18.0f);
            drawList->AddText(ImVec2(namePos.x + 1, namePos.y + 1), IM_COL32(0, 0, 0, 200), cp.name);
            drawList->AddText(namePos, col, cp.name);
        }
    }
}

